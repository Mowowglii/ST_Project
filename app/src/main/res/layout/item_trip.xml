<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:layout_margin="8dp">

    <!-- correspond à la page qui s'affiche si des voyages ont déjà été enregistrés -->

    <ImageView
        android:id="@+id/tripImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/sample_trip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/pastel_purple"
        android:padding="8dp">

        <TextView
            android:id="@+id/tripName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nom du voyage"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tripDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Durée"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>